# --- Database ---
# Local (docker compose up): postgres on 5432. Production: Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentiment_hub

# --- Auth ---
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Entra ID SSO (production). Leave unset locally to use the dev credentials provider.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Dev-only credentials login (never set in production)
DEV_LOGIN_ENABLED=true

# --- File storage ---
# local = filesystem under .storage/ (dev). vercel-blob = production.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# --- LLM ---
# Direct Anthropic:
ANTHROPIC_API_KEY=
# Or OpenAI-compatible gateway (LiteLLM). If set, takes precedence:
LLM_BASE_URL=
LLM_API_KEY=
# fake = deterministic canned responses for dev/tests without keys
LLM_PROVIDER=fake

# --- Embeddings ---
# voyage | fake (deterministic hash embeddings for dev/tests)
EMBEDDINGS_PROVIDER=fake
VOYAGE_API_KEY=

# --- Inngest (leave unset for local dev server: npx inngest-cli dev) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
